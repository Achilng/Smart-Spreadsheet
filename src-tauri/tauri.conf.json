{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "智能表格",
  "version": "0.12.14",
  "identifier": "com.achilng.smart-spreadsheet",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1422",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "智能表格",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../tools/style-extractor/server.mjs": "web-tools/style-extractor/server.mjs",
      "../tools/style-extractor/core.mjs": "web-tools/style-extractor/core.mjs",
      "../tools/style-extractor/credentials.mjs": "web-tools/style-extractor/credentials.mjs",
      "../tools/style-extractor/codex-stream.mjs": "web-tools/style-extractor/codex-stream.mjs",
      "../tools/style-extractor/streaming.mjs": "web-tools/style-extractor/streaming.mjs",
      "../tools/style-extractor/index.html": "web-tools/style-extractor/index.html",
      "../tools/style-extractor/live.js": "web-tools/style-extractor/live.js",
      "../tools/style-extractor/live.css": "web-tools/style-extractor/live.css",
      "../tools/style-extractor/prompt.txt": "web-tools/style-extractor/prompt.txt",
      "../tools/style-review/server.mjs": "web-tools/style-review/server.mjs",
      "../tools/style-review/core.mjs": "web-tools/style-review/core.mjs",
      "../tools/style-review/app.mjs": "web-tools/style-review/app.mjs",
      "../tools/style-review/index.html": "web-tools/style-review/index.html",
      "../tools/style-review/style.css": "web-tools/style-review/style.css"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzMUIyMzhBNjJBNzg4NUUKUldSZWlLZGlpaU1iODgyRUZ3OHJja1JIeHRVZlBmdS80dnRJMllocVNCOGlFV2F1S2VFdThwMFEK",
      "endpoints": [
        "https://github.com/Achilng/Smart-Spreadsheet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
